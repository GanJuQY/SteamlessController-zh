diff --git a/src/app/RemapWindow.cpp b/src/app/RemapWindow.cpp
index 5b69c57..54aca49 100644
--- a/src/app/RemapWindow.cpp
+++ b/src/app/RemapWindow.cpp
@@ -30,7 +30,10 @@ static const std::wstring& GetHtml() {
     // Narrow literal: a wide one would hit MSVC's C2026 "string too big" far
     // sooner. Each piece still has to stay under ~16 K on its own (65 535 is
     // only the limit on the concatenated result), hence the splits below.
-    // HTML is ASCII-only (JS glyphs use \uXXXX escapes); each byte widens 1:1.
+    // The literal below is UTF-8 and is decoded as UTF-8 further down. It used
+    // to be widened one byte per wchar_t, which only round-trips while the
+    // page is ASCII-only (the English original was); the localised page is
+    // not, so every non-ASCII character came out as two mojibake glyphs.
     static const std::wstring html = []() -> std::wstring {
         static const char kHtml[] = R"HTML(
 <!DOCTYPE html>
@@ -1714,10 +1717,13 @@ renderAll();
 </body>
 </html>
 )HTML";
-        std::wstring w;
-        w.reserve(sizeof(kHtml));
-        for (const char* p = kHtml; *p; ++p)
-            w += static_cast<wchar_t>(static_cast<unsigned char>(*p));
+        // Same conversion the launcher and Steam-path readers use: the bytes
+        // are UTF-8, so decode them instead of copying one per wchar_t.
+        const int bytes = static_cast<int>(sizeof(kHtml) - 1);
+        const int chars = MultiByteToWideChar(CP_UTF8, 0, kHtml, bytes, nullptr, 0);
+        if (chars <= 0) return {};
+        std::wstring w(static_cast<size_t>(chars), L'\0');
+        MultiByteToWideChar(CP_UTF8, 0, kHtml, bytes, w.data(), chars);
         return w;
     }();
     return html;
